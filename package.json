{
    "name": "desktop-agent",
    "version": "1.3.0",
    "description": "electron",
    "license": "ISC",
    "author": "MAD",
    "type": "commonjs",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "rebuild": "electron-rebuild",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "start:prod": "AGENT_API_URL=http://localhost:5000 electron .",
        "prod:desktop": "npm run build",
        "build": "electron-builder",
        "check:desktop": "npm test && npm run build"
    },
    "build": {
        "appId": "com.chronomad.desktop-agent",
        "productName": "ChronoMAD Desktop Agent",
        "directories": {
            "buildResources": ".",
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "renderer/**/*",
            "node_modules/**/*",
            "package.json",
            "../frontend/build/**/*"
        ],
        "asarUnpack": [
            "**/*.node"
        ]
    },
    "dependencies": {
        "axios": "^1.16.1",
        "dotenv": "^17.4.2",
        "electron-store": "^11.0.2",
        "get-windows": "^9.3.0",
        "jsonwebtoken": "^9.0.3"
    },
    "devDependencies": {
        "electron": "^42.0.1",
        "electron-builder": "^26.15.2",
        "electron-rebuild": "^3.2.9",
        "jest": "^29.7.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/*.test.js"
        ],
        "collectCoverageFrom": [
            "utils/**/*.js",
            "!**/node_modules/**"
        ]
    }
}
